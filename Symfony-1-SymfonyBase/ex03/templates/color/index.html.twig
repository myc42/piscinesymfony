{% extends 'base.html.twig' %}

{% block title %}Hello ColorController!{% endblock %}

{% block body %}
<style>
    .example-wrapper { margin: 1em auto; max-width: 800px; width: 95%; font: 18px/1.5 sans-serif; }
    .example-wrapper code { background: #F5F5F5; padding: 2px 6px; }
</style>

<div class="example-wrapper">
    <table border="1">
    <!-- En-tête du tableau -->
    <thead>
        <tr>
            <th>Noir</th>
            <th>Rouge</th>
            <th>Bleu</th>
            <th>Vert</th>
        </tr>
    </thead>

    <!-- Corps du tableau : une ligne par nuance -->
    <tbody>
        {% for ligne in lignes %}
            <tr>
                <td style="height: 40px; width: 80px; background-color: {{ ligne.noir }};"></td>
                <td style="height: 40px; width: 80px; background-color: {{ ligne.rouge }};"></td>
                <td style="height: 40px; width: 80px; background-color: {{ ligne.bleu }};"></td>
                <td style="height: 40px; width: 80px; background-color: {{ ligne.vert }};"></td>
            </tr>
        {% endfor %}
    </tbody>
</table>
</div>
{% endblock %}
