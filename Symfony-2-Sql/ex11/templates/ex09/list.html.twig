{% extends 'base.html.twig' %}

{% block title %}Liste des personnes{% endblock %}

{% block body %}

<div class="container mt-4">

    <h1>Liste des personnes</h1>

    <!-- Formulaire de filtrage et de tri (requis pour l'exercice 11) -->
    <form method="GET" action="{{ path('app_list') }}" class="mb-4 p-3 bg-light border rounded">
        <div class="row g-3 align-items-center">
            <div class="col-auto">
                <input type="text" name="search" value="{{ currentSearch ?? '' }}" placeholder="Filtrer par nom..." class="form-control">
            </div>
            
            <div class="col-auto">
                <select name="sort" class="form-select">
                    <option value="name" {{ (currentSort ?? '') == 'name' ? 'selected' : '' }}>Trier par Nom</option>
                    <option value="email" {{ (currentSort ?? '') == 'email' ? 'selected' : '' }}>Trier par Email</option>
                </select>
            </div>

            <div class="col-auto">
                <select name="direction" class="form-select">
                    <option value="ASC" {{ (currentDirection ?? '') == 'ASC' ? 'selected' : '' }}>Croissant</option>
                    <option value="DESC" {{ (currentDirection ?? '') == 'DESC' ? 'selected' : '' }}>Décroissant</option>
                </select>
            </div>

            <div class="col-auto">
                <button type="submit" class="btn btn-primary">Filtrer</button>
            </div>
        </div>
    </form>

    {% for person in persons %}

        <div class="card mb-3">
            <div class="card-body">

                <div>
                    <strong>ID :</strong> {{ person.id }}
                </div>

                <div>
                    <strong>Nom :</strong> {{ person.name }}
                    | <strong>Email :</strong> {{ person.email }}
                </div>

                <div>
                    <strong>Compte bancaire :</strong>

                    {% set hasAccount = false %}

                    {% for account in accounts %}
                        {% if account.personId == person %}
                            {% set hasAccount = true %}
                            {{ account.iban }}
                        {% endif %}
                    {% endfor %}

                    {% if not hasAccount %}
                        Aucun compte bancaire
                    {% endif %}
                </div>

                <div>
                    <strong>Adresses :</strong>

                    {% set hasAddress = false %}

                    {% for address in addresses %}
                        {% if address.person == person %}
                            {% set hasAddress = true %}
                            {{ address.street }}{% if not loop.last %}, {% endif %}
                        {% endif %}
                    {% endfor %}

                    {% if not hasAddress %}
                        Aucune adresse
                    {% endif %}
                </div>

            </div>
        </div>

    {% else %}

        <p>Aucune personne trouvée.</p>

    {% endfor %}

</div>

{% endblock %}