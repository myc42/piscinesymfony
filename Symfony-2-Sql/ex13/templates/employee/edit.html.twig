{% extends 'base.html.twig' %}

{% block title %}Modifier {{ employee.firstname }}{% endblock %}

{% block body %}
    <h1>Modifier {{ employee.firstname }} {{ employee.lastname }}</h1>

{{ form_start(form, {attr: {novalidate: 'novalidate'}}) }}
    {{ form_widget(form) }}
    <button type="submit">{{ button_label|default('Enregistrer') }}</button>
{{ form_end(form) }}
    <p><a href="{{ path('app_employee') }}">← Retour à la liste</a></p>
{% endblock %}