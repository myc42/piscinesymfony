{% extends 'base.html.twig' %}

{% block title %}Nouvel employé{% endblock %}

{% block body %}
    <h1>Créer un employé</h1>

{{ form_start(form, {attr: {novalidate: 'novalidate'}}) }}
    {{ form_widget(form) }}
    <button type="submit">{{ button_label|default('Enregistrer') }}</button>
{{ form_end(form) }}
    <p><a href="{{ path('app_employee') }}">← Retour à la liste</a></p>
{% endblock %}